# Copy to .env and fill in. .env is gitignored and must never be committed.
# Z.AI / BigModel API key, used by the question-generation and eval scripts.
ZAI_API_KEY=

# Which edition this deployment serves.
#   free (default) - the public OER app: no paid tier, no AI features, no caps.
#   pro / full     - the paid edition. Must be asked for by name.
# Unset means FREE, so a deploy that forgets this cannot leak the paid edition.
APP_EDITION=free
